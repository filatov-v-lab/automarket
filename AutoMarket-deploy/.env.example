# Скопируй этот файл в .env и заполни значения

# Обязательно — секретный ключ Django (придумай случайную строку)
SECRET_KEY=django-insecure-your-secret-key-here

# true — режим разработки (SQLite), false — продакшен (PostgreSQL)
DEBUG=true

# Хосты через запятую (для Render — твой домен .onrender.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Только для продакшена на Render — Render подставит автоматически
# DATABASE_URL=postgres://...

# Опционально — Telegram-бот для уведомлений о заказах
# BOT_TOKEN=your-telegram-bot-token
# CHAT_ID=your-chat-id
